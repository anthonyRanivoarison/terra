# Postgres: `docker compose -f infra/docker-compose.yml up -d`, then `bun run db:migrate`
DATABASE_URL=postgres://terra:terra@localhost:5433/terra

# Better Auth: 32+ random characters (`openssl rand -base64 32`)
BETTER_AUTH_SECRET=
# Public URL of apps/web (https://app.example.com in production)
BETTER_AUTH_URL=http://localhost:3000
# Public URL of apps/web for revenue webhooks and SEO (defaults to BETTER_AUTH_URL)
# APP_URL=

# 32 bytes in base64 for encrypting stored provider keys (`openssl rand -base64 32`)
ENCRYPTION_KEY=

# Public URL of apps/ingest, used in the snippet shown to customers (inlined at build time)
NEXT_PUBLIC_INGEST_URL=http://localhost:4000
INGEST_PORT=4000
# Path to the built tracker served at /js/script.js (defaults to packages/tracker/dist/script.js)
# TRACKER_SCRIPT=

# Optional: db-ip ASN database for network names (apps/ingest)
ASN_DB_PATH=

# Production only (infra/docker-compose.prod.yml). GHCR owner of the images, lowercase
GHCR_OWNER=
# Image tag to run (a commit sha, or latest)
TERRA_TAG=latest
# Postgres credentials for the compose stack
POSTGRES_USER=terra
POSTGRES_PASSWORD=
POSTGRES_DB=terra
# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=
# Cloudflare R2 nightly backups (pg_dump | gzip)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=terra-backups
BACKUP_KEEP_DAYS=14
BACKUP_HOUR_UTC=3

# Optional: "Continue with GitHub" (github.com/settings/developers, callback http://localhost:3001/api/auth/callback/github)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: "Google" sign in (console.cloud.google.com, redirect http://localhost:3001/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
